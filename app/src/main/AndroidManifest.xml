<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.mojang.minecraftpe" />
    </queries>

    <application
        android:name=".GrapeApplication"
        android:allowBackup="true"
        android:icon="@drawable/grape_icon"
        android:label="Grape Client"
        android:supportsRtl="true"
        android:theme="@style/Theme.GrapeClient">
        <activity
            android:name=".minecraft.MinecraftHostActivity"
            android:exported="false"
            android:screenOrientation="unspecified">
            <meta-data
                android:name="android.app.lib_name"
                android:value="grape" />
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
